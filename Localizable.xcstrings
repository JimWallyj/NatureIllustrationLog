    },
    "This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer."
          }
        }
      }
    },
    "This removes the photo and notes for this file. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la foto y las notas de este archivo. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "Without Photos access, the date taken can't be filled in automatically — you can still add a photo and enter the date by hand.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a Fotos, la fecha de la foto no se puede completar automáticamente; aún puedes agregar una foto e ingresar la fecha manualmente."
          }
        }
      }
    },
    "Select": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionar"
          }
        }
      }
    },
