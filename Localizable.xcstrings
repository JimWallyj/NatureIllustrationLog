      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importación completada"
          }
        }
      }
    },
    "Imported: %lld · Skipped: %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importados: %1$lld · Omitidos: %2$lld"
          }
        }
      }
    },
    "Imported: %lld · Skipped: %lld · Couldn't read: %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importados: %1$lld · Omitidos: %2$lld · No se pudieron leer: %3$lld"
          }
        }
      }
    },
    "Not Enough Space": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio"
          }
        }
      }
    },
    "There isn't enough space on this device to import %lld files (about %@ needed). Free up space, or offload some files to your Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio en este dispositivo para importar %1$lld archivos (se necesitan unos %2$@). Libera espacio o descarga algunos archivos a tu Mac."
          }
        }
      }
    },
    "Read-Only: shared with you. You can view this file but not change it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura: compartido contigo. Puedes ver este archivo, pero no cambiarlo."
          }
        }
      }
    },
    "No photos": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin fotos"
          }
        }
      }
    },
    "No date": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin fecha"
          }
        }
      }
    },
    "Delete 1 file?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar 1 archivo?"
          }
        }
      }
    },
    "Delete %lld files?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %lld archivos?"
          }
        }
      }
    },
    "This removes their photos and notes. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina sus fotos y notas. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "This removes their photos and notes. This can't be undone. Full files on your Mac are not affected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina sus fotos y notas. Esta acción no se puede deshacer. Los archivos completos en tu Mac no se verán afectados."
          }
        }
      }
    },
    "Update This File": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar este archivo"
          }
        }
      }
    },
    "This is the same file, sent from one of your devices. Update replaces the copy here with it; the current version goes to Recently Replaced for 30 days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el mismo archivo, enviado desde uno de tus dispositivos. Actualizar reemplaza la copia de aquí; la versión actual pasa a Recientemente reemplazados durante 30 días."
          }
        }
      }
    },
    "Update Anyway?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Actualizar de todos modos?"
          }
        }
      }
    },
    "Update Anyway": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar de todos modos"
          }
        }
      }
    },
    "The copy on this device was changed more recently. Update anyway?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de este dispositivo se modificó más recientemente. ¿Actualizar de todos modos?"
          }
        }
      }
    },
    "Updated: %lld. The older versions were moved to Recently Replaced (gear icon on Home) for 30 days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizados: %lld. Las versiones anteriores se movieron a Recientemente reemplazados (ícono de engranaje en Inicio) durante 30 días."
          }
        }
      }
    },
    "Recently Replaced (%lld)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recientemente reemplazados (%lld)"
          }
        }
      }
    },
    "Recently Replaced": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recientemente reemplazados"
          }
        }
      }
    },
