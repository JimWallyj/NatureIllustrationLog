      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar"
          }
        }
      }
    },
    "Delete Now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar ahora"
          }
        }
      }
    },
    "Nothing Recently Replaced": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada reemplazado recientemente"
          }
