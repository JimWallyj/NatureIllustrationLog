      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar a mis dispositivos"
          }
        }
      }
    },
    "Share Read-Only": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir solo lectura"
          }
        }
      }
    },
    "Send to My Devices keeps the files editable. Share Read-Only lets others view them but not change them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar a mis dispositivos mantiene los archivos editables. Compartir solo lectura permite que otras personas los vean, pero no los cambien."
          }
        }
      }
    },
    "%lld of the %lld selected files can't be sent (read-only or already on your Mac). Send the other %lld?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de los %2$lld archivos seleccionados no se pueden enviar (son de solo lectura o ya están en tu Mac). ¿Enviar los otros %3$lld?"
          }
        }
      }
    },
    "Can't Send Files": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden enviar los archivos"
          }
        }
      }
    },
    "The selected files can't be sent (read-only or already on your Mac).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos seleccionados no se pueden enviar (son de solo lectura o ya están en tu Mac)."
          }
        }
      }
    },
    "Couldn't Prepare Files": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron preparar los archivos"
          }
        }
      }
    },
    "Something went wrong while preparing the files to send. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal al preparar los archivos para enviar. Inténtalo de nuevo."
