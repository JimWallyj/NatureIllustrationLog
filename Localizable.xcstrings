      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar archivos"
          }
        }
      }
    },
    "Importing files…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importando archivos…"
          }
        }
      }
    },
    "Name Conflict": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflicto de nombre"
          }
        }
      }
    },
    "A file named \"%@\" already exists on this device. What would you like to do with the incoming file?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un archivo llamado \"%@\" en este dispositivo. ¿Qué quieres hacer con el archivo recibido?"
          }
        }
      }
    },
    "Use \"%@\"": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar \"%@\""
          }
        }
      }
    },
    "Or enter a new name:": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O escribe un nombre nuevo:"
          }
        }
      }
    },
    "New name": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre nuevo"
          }
        }
      }
    },
    "That name is also taken. Please try another.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese nombre también está en uso. Prueba con otro."
          }
        }
      }
    },
    "Use This Name": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar este nombre"
          }
        }
      }
    },
    "Do this for all remaining conflicts": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer esto con todos los conflictos restantes"
          }
        }
      }
    },
    "Applies to the suggested name and Skip.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al nombre sugerido y a Omitir."
          }
        }
      }
    },
    "Skip This File": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir este archivo"
          }
        }
      }
    },
